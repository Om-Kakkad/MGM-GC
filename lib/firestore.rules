rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Check if user is a league player
    function isLeaguePlayer() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'league_player';
    }
    
    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      // Allow admins to delete users
      allow delete: if isAdmin();
    }
    
    // Events collection rules
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      
      // Teams subcollection rules
      match /teams/{teamId} {
        allow read: if isAuthenticated();
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || 
                      (isAuthenticated() && 
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players']));
      }
      
      // Matches subcollection rules
      match /matches/{matchId} {
        allow read: if isAuthenticated();
        allow create: if isAdmin();
        function matchDoc() {
          return get(/databases/$(database)/documents/events/$(eventId)/matches/$(matchId));
        }
        function participants() {
          return matchDoc().data.participantUids;
        }
        allow update, delete: if isAdmin() || (
          isLeaguePlayer() &&
          participants().hasAny([request.auth.uid]) &&
          !matchDoc().data.matchOver
        );

        match /holeResults/{holeId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin() || (
            isLeaguePlayer() &&
            participants().hasAny([request.auth.uid]) &&
            !matchDoc().data.matchOver
          );
        }
      }
      
      // Event registrations subcollection rules
      match /registrations/{registrationId} {
        allow read: if isAuthenticated();
        allow create: if isLeaguePlayer() || isAdmin();
        allow update, delete: if isAdmin();
      }
    }
    
    // Allow cascade batch deletions by admins
    match /{document=**} {
      allow read, write: if isAdmin() && 
                         (request.resource == null || 
                          request.resource.data.keys().hasAny(['players', 'teams', 'userId']));
    }
  }
}
