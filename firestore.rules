rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // During development, allow all operations for testing
    // IMPORTANT: REMOVE THIS RULE FOR PRODUCTION
    match /{document=**} {
      allow read, write: if true;
    }
    
    // The rules below will only be applied if the above rule is removed
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isFirstUser() {
      return isSignedIn() && 
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isLeaguePlayer() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow users to create their own document if it doesn't exist yet
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isAdmin() || isOwner(userId);
      allow delete: if isAdmin();
    }
    
    // TeeTimes collection
    match /teeTimes/{dateId} {
      allow read: if isSignedIn();
      
      // Allow any authenticated user to create date documents
      allow create, update: if isSignedIn();
      // Only admins can delete date documents
      allow delete: if isAdmin();
      
      // Slots subcollection
      match /slots/{slotId} {
        // Anyone signed in can read slots
        allow read: if isSignedIn();
        
        // Allow any authenticated user to create slots
        allow create: if isSignedIn();
        
        // Booking logic
        allow update: if isSignedIn() && (
          // Admins can update any slot
          isAdmin() ||
          
          // Users can book slots that are open
          (resource.data.status == 'open' && 
           (request.resource.data.status == 'booked' ||
           request.resource.data.status == 'held')) ||
          
          // Users can complete their own held bookings
          (resource.data.status == 'held' && 
           resource.data.bookedByUid == request.auth.uid &&
           request.resource.data.status == 'booked')
        );
        
        // Only admins can delete slots
        allow delete: if isSignedIn();
      }
    }
    
    // Bookings collection
    match /bookings/{bookingId} {
      // Users can read their own bookings, admins can read all
      allow read: if isSignedIn() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );
      
      // Users can create bookings, admins can create/update
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      
      // Only admins can delete bookings
      allow delete: if isAdmin();
    }

    // Sponsors subcollection rules
    match /sponsors/{sponsorId} {
      allow read, write: if isSignedIn();
    }
    
    // Scorecard collection
    match /scorecards/{scorecardId} {
      // Anyone signed in can read and write scorecards
      allow read, write: if isSignedIn();
    }
    
    // Handicap records collection
    match /handicapRecords/{recordId} {
      // Anyone signed in can read handicap records
      allow read: if isSignedIn();
      // Only the user and admins can write to handicap records
      allow write: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Event registrations subcollection rules
    match /registrations/{registrationId} {
      allow read: if isAuthenticated();
      allow create: if isLeaguePlayer() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Aggregate scores subcollection rules
    match /aggregateScores/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Allow cascade batch deletions by admins
    match /{document=**} {
      allow read, write: if isAdmin() && 
                         (request.resource == null || 
                          request.resource.data.keys().hasAny(['players', 'teams', 'userId']));
    }
  }
}
